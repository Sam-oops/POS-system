# Copy to .env and change the secrets for anything beyond local dev.
# docker-compose already provides safe defaults, so the app runs without a .env.

# Used to sign/verify login JWTs (Stage 1).
JWT_SECRET=dev_jwt_secret_change_me

# Shared secret the payment provider uses to HMAC-sign webhooks (Stage 5).
WEBHOOK_SECRET=dev_webhook_secret_change_me
